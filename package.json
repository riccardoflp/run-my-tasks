{
  "name": "run-my-tasks",
  "displayName": "Run My Tasks",
  "description": "Quickly run workspace tasks and launch configurations from a status bar picker or side panel",
  "version": "0.7.0",
  "license": "MIT",
  "publisher": "RiccardoFilippozzi",
  "repository": "https://github.com/riccardoflp/run-my-tasks",
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "resources/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "tasks",
    "task runner",
    "build",
    "launch",
    "debug",
    "status bar"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "run-my-tasks-container",
          "title": "Run My Tasks",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "run-my-tasks-container": [
        {
          "id": "run-my-tasks.groupsView",
          "name": "Groups"
        },
        {
          "id": "run-my-tasks.tasksView",
          "name": "Tasks"
        },
        {
          "id": "run-my-tasks.launchView",
          "name": "Launch Configurations"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "run-my-tasks.launchView",
        "contents": "No launch configurations found.\n[Open launch.json](command:workbench.action.debug.configure)",
        "when": "!runMyTasks.filterActive"
      }
    ],
    "commands": [
      {
        "command": "run-my-tasks.showTaskPicker",
        "title": "Run Task...",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.refreshTasksView",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.runTaskFromTree",
        "title": "Run Task",
        "icon": "$(run)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.runTaskInEditor",
        "title": "Run in Editor",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.runTaskInPanel",
        "title": "Run in Panel",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.stopTaskFromTree",
        "title": "Stop Task",
        "icon": "$(stop)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.createGroup",
        "title": "Create Group",
        "icon": "$(add)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.renameGroup",
        "title": "Rename Group",
        "icon": "$(edit)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.deleteGroup",
        "title": "Delete Group",
        "icon": "$(trash)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.exportGroups",
        "title": "Export Groups...",
        "icon": "$(export)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.importGroups",
        "title": "Import Groups...",
        "icon": "$(cloud-download)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.addTaskToGroup",
        "title": "Add to Group",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.removeTaskFromGroup",
        "title": "Remove from Group",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.runGroup",
        "title": "Run Group",
        "icon": "$(run-all)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.stopGroup",
        "title": "Stop Group",
        "icon": "$(debug-stop)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.openTasksJson",
        "title": "Open tasks.json",
        "icon": "$(go-to-file)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.moveTaskUp",
        "title": "Move Up",
        "icon": "$(arrow-up)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.moveTaskDown",
        "title": "Move Down",
        "icon": "$(arrow-down)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.moveGroupUp",
        "title": "Move Up",
        "icon": "$(arrow-up)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.moveGroupDown",
        "title": "Move Down",
        "icon": "$(arrow-down)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.focusTaskTerminal",
        "title": "Show Terminal",
        "icon": "$(terminal)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.search",
        "title": "Search...",
        "icon": "$(search)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.clearSearch",
        "title": "Clear Search",
        "icon": "$(clear-all)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.debugLaunchFromTree",
        "title": "Start Debugging",
        "icon": "$(debug-start)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.runLaunchFromTree",
        "title": "Run Without Debugging",
        "icon": "$(run)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.stopLaunchFromTree",
        "title": "Stop",
        "icon": "$(debug-stop)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.openLaunchJson",
        "title": "Open launch.json",
        "icon": "$(go-to-file)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.collapseAllGroups",
        "title": "Collapse All Groups",
        "icon": "$(collapse-all)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.expandAllGroups",
        "title": "Expand All Groups",
        "icon": "$(expand-all)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.collapseAllTasks",
        "title": "Collapse All Tasks",
        "icon": "$(collapse-all)",
        "category": "Run My Tasks"
      },
      {
        "command": "run-my-tasks.expandAllTasks",
        "title": "Expand All Tasks",
        "icon": "$(expand-all)",
        "category": "Run My Tasks"
      }
    ],
    "keybindings": [
      {
        "command": "run-my-tasks.showTaskPicker",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "run-my-tasks.renameGroup",
        "key": "f2",
        "when": "focusedView == run-my-tasks.groupsView && viewItem == virtualGroup"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "run-my-tasks.focusTaskTerminal",
          "when": "false"
        },
        {
          "command": "run-my-tasks.runTaskInEditor",
          "when": "false"
        },
        {
          "command": "run-my-tasks.runTaskInPanel",
          "when": "false"
        },
        {
          "command": "run-my-tasks.debugLaunchFromTree",
          "when": "false"
        },
        {
          "command": "run-my-tasks.runLaunchFromTree",
          "when": "false"
        },
        {
          "command": "run-my-tasks.stopLaunchFromTree",
          "when": "false"
        },
        {
          "command": "run-my-tasks.clearSearch",
          "when": "runMyTasks.filterActive"
        }
      ],
      "view/title": [
        {
          "command": "run-my-tasks.search",
          "when": "view == run-my-tasks.groupsView || view == run-my-tasks.tasksView || view == run-my-tasks.launchView",
          "group": "navigation@1"
        },
        {
          "command": "run-my-tasks.clearSearch",
          "when": "(view == run-my-tasks.groupsView || view == run-my-tasks.tasksView || view == run-my-tasks.launchView) && runMyTasks.filterActive",
          "group": "navigation@2"
        },
        {
          "command": "run-my-tasks.createGroup",
          "when": "view == run-my-tasks.groupsView",
          "group": "navigation@3"
        },
        {
          "command": "run-my-tasks.collapseAllGroups",
          "when": "view == run-my-tasks.groupsView",
          "group": "navigation@4"
        },
        {
          "command": "run-my-tasks.expandAllGroups",
          "when": "view == run-my-tasks.groupsView",
          "group": "navigation@5"
        },
        {
          "command": "run-my-tasks.collapseAllTasks",
          "when": "view == run-my-tasks.tasksView",
          "group": "navigation@4"
        },
        {
          "command": "run-my-tasks.expandAllTasks",
          "when": "view == run-my-tasks.tasksView",
          "group": "navigation@5"
        },
        {
          "command": "run-my-tasks.openTasksJson",
          "when": "view == run-my-tasks.groupsView || view == run-my-tasks.tasksView",
          "group": "navigation@6"
        },
        {
          "command": "run-my-tasks.openLaunchJson",
          "when": "view == run-my-tasks.launchView",
          "group": "navigation@6"
        },
        {
          "command": "run-my-tasks.refreshTasksView",
          "when": "view == run-my-tasks.groupsView || view == run-my-tasks.tasksView || view == run-my-tasks.launchView",
          "group": "navigation@7"
        },
        {
          "command": "run-my-tasks.exportGroups",
          "when": "view == run-my-tasks.groupsView",
          "group": "1_transfer@1"
        },
        {
          "command": "run-my-tasks.importGroups",
          "when": "view == run-my-tasks.groupsView",
          "group": "1_transfer@2"
        }
      ],
      "view/item/context": [
        {
          "command": "run-my-tasks.runTaskFromTree",
          "when": "view == run-my-tasks.tasksView && viewItem == idleTask",
          "group": "inline"
        },
        {
          "command": "run-my-tasks.stopTaskFromTree",
          "when": "view == run-my-tasks.tasksView && viewItem == runningTask",
          "group": "inline"
        },
        {
          "command": "run-my-tasks.runTaskFromTree",
          "when": "view == run-my-tasks.groupsView && viewItem == idleTaskInGroup",
          "group": "inline"
        },
        {
          "command": "run-my-tasks.stopTaskFromTree",
          "when": "view == run-my-tasks.groupsView && viewItem == runningTaskInGroup",
          "group": "inline"
        },
        {
          "command": "run-my-tasks.debugLaunchFromTree",
          "when": "view == run-my-tasks.launchView && viewItem == idleLaunch",
          "group": "inline"
        },
        {
          "command": "run-my-tasks.stopLaunchFromTree",
          "when": "view == run-my-tasks.launchView && viewItem == runningLaunch",
          "group": "inline"
        },
        {
          "command": "run-my-tasks.debugLaunchFromTree",
          "when": "view == run-my-tasks.groupsView && viewItem == idleLaunchInGroup",
          "group": "inline"
        },
        {
          "command": "run-my-tasks.stopLaunchFromTree",
          "when": "view == run-my-tasks.groupsView && viewItem == runningLaunchInGroup",
          "group": "inline"
        },
        {
          "command": "run-my-tasks.runTaskInEditor",
          "when": "(viewItem == idleTask || viewItem == idleTaskInGroup) && config.runMyTasks.terminalLocation != editor",
          "group": "0_run"
        },
        {
          "command": "run-my-tasks.runTaskInPanel",
          "when": "(viewItem == idleTask || viewItem == idleTaskInGroup) && config.runMyTasks.terminalLocation == editor",
          "group": "0_run"
        },
        {
          "command": "run-my-tasks.runLaunchFromTree",
          "when": "viewItem == idleLaunch || viewItem == idleLaunchInGroup",
          "group": "0_run"
        },
        {
          "command": "run-my-tasks.runGroup",
          "when": "view == run-my-tasks.groupsView && viewItem == virtualGroup",
          "group": "inline@1"
        },
        {
          "command": "run-my-tasks.stopGroup",
          "when": "view == run-my-tasks.groupsView && viewItem == virtualGroup",
          "group": "inline@2"
        },
        {
          "command": "run-my-tasks.renameGroup",
          "when": "view == run-my-tasks.groupsView && viewItem == virtualGroup",
          "group": "1_modification@1"
        },
        {
          "command": "run-my-tasks.deleteGroup",
          "when": "view == run-my-tasks.groupsView && viewItem == virtualGroup",
          "group": "1_modification@2"
        },
        {
          "command": "run-my-tasks.addTaskToGroup",
          "when": "view == run-my-tasks.tasksView && (viewItem == idleTask || viewItem == runningTask)",
          "group": "1_group"
        },
        {
          "command": "run-my-tasks.addTaskToGroup",
          "when": "view == run-my-tasks.launchView && (viewItem == idleLaunch || viewItem == runningLaunch)",
          "group": "1_group"
        },
        {
          "command": "run-my-tasks.removeTaskFromGroup",
          "when": "view == run-my-tasks.groupsView && viewItem =~ /InGroup$/",
          "group": "1_group"
        },
        {
          "command": "run-my-tasks.moveTaskUp",
          "when": "view == run-my-tasks.groupsView && viewItem =~ /InGroup$/",
          "group": "2_order@1"
        },
        {
          "command": "run-my-tasks.moveTaskDown",
          "when": "view == run-my-tasks.groupsView && viewItem =~ /InGroup$/",
          "group": "2_order@2"
        },
        {
          "command": "run-my-tasks.moveGroupUp",
          "when": "view == run-my-tasks.groupsView && viewItem == virtualGroup",
          "group": "2_order@1"
        },
        {
          "command": "run-my-tasks.moveGroupDown",
          "when": "view == run-my-tasks.groupsView && viewItem == virtualGroup",
          "group": "2_order@2"
        }
      ]
    },
    "configuration": {
      "title": "Run My Tasks",
      "properties": {
        "runMyTasks.statusBarAlignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "Which side of the status bar to place the task runner button."
        },
        "runMyTasks.statusBarPriority": {
          "type": "number",
          "default": 100,
          "description": "Priority of the status bar item. Higher numbers appear further left (for Left alignment)."
        },
        "runMyTasks.showTaskType": {
          "type": "boolean",
          "default": true,
          "description": "Show the task command, or the launch configuration type, as a detail line in the picker."
        },
        "runMyTasks.terminalLocation": {
          "type": "string",
          "enum": [
            "panel",
            "editor"
          ],
          "enumDescriptions": [
            "Open the terminals of the tasks in the panel, as VS Code does.",
            "Open the terminals of the tasks in the editor area, as editor tabs."
          ],
          "default": "panel",
          "description": "Where the terminals of the tasks started from Run My Tasks open. The right-click menu of a task can run it in the other place."
        },
        "runMyTasks.editorTerminalLayout": {
          "type": "string",
          "enum": [
            "split",
            "group",
            "tab"
          ],
          "enumDescriptions": [
            "Split the editor area: each terminal opens in its own editor group, after the files you are working on and the other terminals, in the direction of `#runMyTasks.editorTerminalPosition#`.",
            "Open all the terminals as tabs of one editor group, to the right of the files you are working on.",
            "Open the terminals as full tabs in the editor group you are working in, without creating a new group."
          ],
          "default": "split",
          "description": "How the terminals of the tasks open in the editor area, when they open there."
        },
        "runMyTasks.editorTerminalPosition": {
          "type": "string",
          "enum": [
            "right",
            "below"
          ],
          "enumDescriptions": [
            "The terminals open to the right of the files you are working on; with the `split` layout, each one to the right of the previous one.",
            "The terminals open below the files you are working on; with the `split` layout, each one below the previous one."
          ],
          "default": "right",
          "markdownDescription": "Where the terminals open with respect to the files you are working on, when `#runMyTasks.editorTerminalLayout#` is `split` or `group`. With `split` every terminal is split in this direction, after the previous one."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "pretest": "npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "mocha": "^12.0.2",
    "typescript": "^5.4.0"
  }
}
